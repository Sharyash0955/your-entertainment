# Language detection and syntax overrides for GitHub Linguist
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.py linguist-detectable=true
*.sql linguist-detectable=true
*.sh linguist-detectable=true
*.html linguist-detectable=true
*.css linguist-detectable=true
Dockerfile linguist-detectable=true

# Mark minified or bundled files as generated so they don't skew repository language stats
dist/** linguist-generated=true
bun.lock linguist-generated=true
package-lock.json linguist-generated=true
seat_booking.sqlite linguist-generated=true
